// Peça nomes ao usuario ate ele digitar 'fim' e exiba a lista com foreach
Console.WriteLine("\nExercício 3 - Nomes em lista\n");

string nome = "";
List<string> list = new List<string>();
do
{
    Console.WriteLine("Escreve nomes para serem colocados em uma lista ou digite 'fim' para sair");
    nome = Console.ReadLine();
    if (nome != "fim")
    {
        list.Add(nome);
    }
} while (nome != "fim");

Console.WriteLine("\nNomes dentro da lista: ");
foreach (string nomes in list)
{
    Console.WriteLine(nomes);
}
Console.WriteLine($"Total de nomes da lista: {list.Count}");


////-4.Crie um array com 5 notas e calcule a media usando foreach
Console.WriteLine("\n Exercício 4\n");

double[] arryNotas = {7, 5, 8, 9, 7.3};
double media = 0;

foreach (double notas in arryNotas)
{
    media += notas;
}
Console.WriteLine($"Média de notas: {media / arryNotas.Length}");

