//Exercício 6
Console.WriteLine("\n Exercício 6 - Contar números inteiros do usuário");

List<int> numeros = new List<int>();
string? strNum;

Console.WriteLine("Digite números reais e inteiros, iremos calcular a quantidade digitada. (0) para sair");
do
{
    strNum = Console.ReadLine();

    if (int.TryParse(strNum, out int num1))
    {
        Console.WriteLine($"Variável {strNum} convertido para inteiro: {num1}");
    }
    else
    {
        Console.WriteLine($"Não foi possível converte o número: {strNum}");
    }

    numeros.Add(num1);

} while (strNum != "0");

int numPositivos = 0;
int indice = 0;

while (indice < numeros.Count)
{
    if (numeros[indice] > 0)
    {
        numPositivos++;
    }
    indice++;
};

Console.WriteLine($"\nQuantidade de números inteiros: {numPositivos}");
